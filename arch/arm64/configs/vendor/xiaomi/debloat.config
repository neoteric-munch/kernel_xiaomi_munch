# Wi-Fi: qcacld-3.0 is the only WLAN driver
CONFIG_WLAN_VENDOR_ADMTEK=n
CONFIG_WLAN_VENDOR_ATH=n
CONFIG_WLAN_VENDOR_ATMEL=n
CONFIG_WLAN_VENDOR_BROADCOM=n
CONFIG_WLAN_VENDOR_CISCO=n
CONFIG_WLAN_VENDOR_INTEL=n
CONFIG_WLAN_VENDOR_INTERSIL=n
CONFIG_WLAN_VENDOR_MARVELL=n
CONFIG_WLAN_VENDOR_MEDIATEK=n
CONFIG_WLAN_VENDOR_RALINK=n
CONFIG_WLAN_VENDOR_REALTEK=n
CONFIG_WLAN_VENDOR_RSI=n
CONFIG_WLAN_VENDOR_ST=n
CONFIG_WLAN_VENDOR_TI=n
CONFIG_WLAN_VENDOR_ZYDAS=n
CONFIG_WLAN_VENDOR_QUANTENNA=n

# Media, storage and input hardware these phones don't have
CONFIG_MEDIA_DIGITAL_TV_SUPPORT=n
CONFIG_MEDIA_RADIO_SUPPORT=n
CONFIG_I2C_RTC6226_QCA=n
CONFIG_DVB_MPQ=n
CONFIG_MMC=n
CONFIG_USB_ISP1760=n
CONFIG_USB_PCI=n
CONFIG_SND_PCI=n
CONFIG_INPUT_TABLET=n
CONFIG_SERIO=n
CONFIG_KEYBOARD_ATKBD=n
CONFIG_USB_SERIAL=n
CONFIG_USB_CONFIGFS_F_CCID=n
CONFIG_USB_EHSET_TEST_FIXTURE=n
CONFIG_USB_LINK_LAYER_TEST=n
CONFIG_MTD=n
CONFIG_UIO=n
CONFIG_BLK_DEV_RAM=n
CONFIG_NETWORK_FILESYSTEMS=n
CONFIG_ECRYPT_FS=n
CONFIG_CRYPTO_TWOFISH=n
CONFIG_HW_RANDOM_CAVIUM=n
CONFIG_UID16=n

# Debugging
CONFIG_SCHEDSTATS=n
CONFIG_SPMI_MSM_PMIC_ARB_DEBUG=n
CONFIG_DEBUG_BUGVERBOSE=n
CONFIG_IPC_LOGGING=n
CONFIG_QCOM_INITIAL_LOGBUF=n
CONFIG_MSM_BOOT_STATS=n
CONFIG_IPA3_REGDUMP=n
CONFIG_SCSI_LOGGING=n
CONFIG_ALLOW_DEV_COREDUMP=n
CONFIG_COREDUMP=n
CONFIG_EDAC=n
CONFIG_QCOM_DCC_V2=n
CONFIG_MSM_RDBG=n
CONFIG_STM=n

# In-kernel headers archive (only used by on-device bcc/bpftrace)
CONFIG_IKHEADERS=n

# Drivers for other SoCs whose DT nodes don't exist on kona
CONFIG_ARM_CPUIDLE=n
CONFIG_BACKLIGHT_GENERIC=n
CONFIG_DEVFREQ_SIMPLE_DEV=n
CONFIG_POWER_RESET_SYSCON=n
CONFIG_QCOM_A53PLL=n
CONFIG_QCOM_CLK_APCS_MSM8916=n
CONFIG_QCOM_GLINK_PKT=n
CONFIG_REGULATOR_QCOM_RPMH=n
CONFIG_REGULATOR_STUB=n
CONFIG_USB_DWC3_OF_SIMPLE=n
CONFIG_USB_DWC3_QCOM=n
