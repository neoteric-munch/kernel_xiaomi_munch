CONFIG_NET_VENDOR_TEHUTI=n
CONFIG_NET_VENDOR_TI=n
CONFIG_NET_VENDOR_VIA=n
CONFIG_NET_VENDOR_WIZNET=n
CONFIG_AQFWD=n
CONFIG_IGB=n
CONFIG_SKY2=n
CONFIG_SMSC911X=n
CONFIG_USB_RTL8150=n
CONFIG_USB_LAN78XX=n
CONFIG_USB_NET_AX8817X=n
CONFIG_USB_NET_NET1080=n
CONFIG_USB_NET_CDC_SUBSET=n
CONFIG_USB_NET_ZAURUS=n
