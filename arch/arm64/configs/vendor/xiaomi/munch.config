# Platform
CONFIG_MACH_XIAOMI_MUNCH=y

# Touchscreen
CONFIG_TOUCHSCREEN_FOCALTECH_3658U=y
CONFIG_TOUCHSCREEN_XIAOMI_TOUCHFEATURE=y
CONFIG_TOUCHSCREEN_SUPPORT_NEW_GAME_MODE=y

# Fingerprint
CONFIG_INPUT_FINGERPRINT=y
CONFIG_FINGERPRINT_FPC=y
CONFIG_FINGERPRINT_GOODIX=y

# Power
CONFIG_QPNP_SMB5=n
CONFIG_QPNP_SMB5_MUNCH=y
CONFIG_BQ2597X_CHARGE_PUMP_STANDALONE_MUNCH=y
CONFIG_CHARGER_LN8000_MUNCH=y
CONFIG_FUEL_GAUGE_BQ27Z561_MUNCH=y

# Ultrasound Proximity
CONFIG_US_PROXIMITY=y

# Vibrator
CONFIG_INPUT_AW86927_HAPTIC=y

# Camera
CONFIG_TECHPACK_CAMERA_XIAOMI=y

# Hardware of other SM8250 devices that munch doesn't have
CONFIG_AIROHA_GPS=n
CONFIG_BACKLIGHT_DUALKTZ8866=n
CONFIG_BACKLIGHT_KTZ8866=n
CONFIG_BACKLIGHT_QCOM_SPMI_WLED=n
CONFIG_HALL_AKM09970=n
CONFIG_HL6111R=n
CONFIG_I3C_MASTER_QCOM_GENI=n
CONFIG_INPUT_XIAOMI_KEYBOARD=n
CONFIG_KEYBOARD_NANO_8030=n
CONFIG_LEDS_AW2015=n
CONFIG_MSM_QBT_HANDLER=n
CONFIG_PS5169=n
CONFIG_QTI_BCL_SOC_DRIVER=n
CONFIG_REGULATOR_QPNP_LCDB=n
